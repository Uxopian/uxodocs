{
  "name": "uxodocs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "prebuild": "node ./scripts/updateLastModified.mjs && node ./scripts/generateSecondaryNav.mjs && node ./scripts/generateTopCategories.mjs",
    "update:lastModified": "node ./scripts/updateLastModified.mjs",
    "generate:topCategories": "node ./scripts/generateTopCategories.mjs",
    "generate:releases": "node ./scripts/generateFast2Releases.mjs && node ./scripts/generateFlowerDocsReleases.mjs && node ./scripts/generateARenderReleases.mjs",
    "build": "docusaurus build && if [ \"$BUILD_PDF\" = \"1\" ]; then node scripts/organize-pdfs.mjs; fi",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@docusaurus/theme-mermaid": "^3.9.2",
    "@docusaurus/theme-search-algolia": "^3.9.2",
    "@easyops-cn/docusaurus-search-local": "^0.52.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-papersaurus": "^2.0.3",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "baseline-browser-mapping": "^2.9.6",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}