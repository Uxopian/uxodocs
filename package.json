{
    "name": "uxodocs",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "docusaurus": "docusaurus",
        "start": "docusaurus start",
        "prebuild": "node ./scripts/updateLastModified.mjs && node ./scripts/generateSecondaryNav.mjs && node ./scripts/generateTopCategories.mjs",
        "update:lastModified": "node ./scripts/updateLastModified.mjs",
        "generate:topCategories": "node ./scripts/generateTopCategories.mjs",
        "generate:releases": "node ./scripts/generateFast2Releases.mjs && node ./scripts/generateFlowerDocsReleases.mjs && node ./scripts/generateARenderReleases.mjs && node ./scripts/generateUxopianAiReleases.mjs",
        "build": "docusaurus build && if [ \"$BUILD_PDF\" = \"1\" ]; then node scripts/organize-pdfs.mjs; fi",
        "swizzle": "docusaurus swizzle",
        "deploy": "docusaurus deploy",
        "clear": "docusaurus clear",
        "serve": "docusaurus serve",
        "write-translations": "docusaurus write-translations",
        "write-heading-ids": "docusaurus write-heading-ids",
        "typecheck": "tsc",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
    },
    "dependencies": {
        "@docusaurus/core": "^3.9.2",
        "@docusaurus/preset-classic": "^3.9.2",
        "@docusaurus/theme-mermaid": "^3.9.2",
        "@docusaurus/theme-search-algolia": "^3.9.2",
        "@easyops-cn/docusaurus-search-local": "^0.53.0",
        "@mdx-js/react": "^3.0.0",
        "cheerio": "^1.2.0",
        "clsx": "^2.0.0",
        "easy-pdf-merge": "^0.2.6",
        "express": "^4.17.1",
        "fs-extra": "^11.3.3",
        "github-slugger": "^2.0.0",
        "pdf-parse": "^2.4.5",
        "prism-react-renderer": "^2.3.0",
        "puppeteer": "^24.37.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@docusaurus/module-type-aliases": "^3.9.2",
        "@docusaurus/tsconfig": "^3.9.2",
        "@docusaurus/types": "^3.9.2",
        "baseline-browser-mapping": "^2.9.19",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3"
    },
    "browserslist": {
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 3 chrome version",
            "last 3 firefox version",
            "last 5 safari version"
        ]
    },
    "overrides": {
        "lodash-es": "4.17.23"
    },
    "engines": {
        "node": ">=20.0"
    }
}