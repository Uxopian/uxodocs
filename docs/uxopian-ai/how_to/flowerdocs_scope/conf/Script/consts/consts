const BASE_URL = window.location.origin + '/gui';
const GATEWAY_PATH = '/gateway/uxopian-ai';
const SCOPE = JSAPI.get().getUserAPI().getScope();

// Through FlowerDocs' own proxy (the Gateway Route): JS/CSS bundle, REST calls and SSE streaming.
const UXO_AI_ENDPOINT = `${BASE_URL}/plugins/${SCOPE}${GATEWAY_PATH}`;

// Optional. Public address of uxopian-gateway itself (e.g. https://ai-gateway.example.com),
// used only for the WebSocket channel, which FlowerDocs' proxy cannot forward.
// Left blank, chat and Quick Prompt still answer; only server-to-client push actions stay silent.
const WS_GATEWAY_URL_RAW = '';
const WS_UXO_AI_ENDPOINT = WS_GATEWAY_URL_RAW
  ? `${WS_GATEWAY_URL_RAW}/gui${GATEWAY_PATH}`
  : '';
