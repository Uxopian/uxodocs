# =============================================================================
# Environment variables for the Uxopian AI + Alfresco + ARender stack
# =============================================================================
# Copy this file:
#   cp .env.example .env
# Then edit .env with your actual values.
# =============================================================================

# --- Uxopian AI image versions ---
UXOPIAN_VERSION=2026.0.0-ft4
# uxopian-gateway has not shipped a 2026.0.0-ft4 tag yet — pinned separately.
GATEWAY_VERSION=2026.0.0-ft3
OPENSEARCH_VERSION=3.3.2
REGISTRY=artifactory.arondor.cloud:5001

# --- Public URL of the gateway ---
# Must be reachable from the end-user browser, and MUST be same-origin with
# Alfresco Share (same host:port). The gateway is routed through the Traefik
# proxy on :8080 alongside Share — do not point this at the gateway's own
# :8085, which is not exposed to the browser. uxopian-ai and the gateway both
# echo the request Origin into Access-Control-Allow-Origin; stacked across a
# real cross-origin call, the duplicate header is rejected by the browser.
# Same-origin requests never go through that check, so this is not a CORS
# config to fix — it's the port to leave alone.
# Development (localhost): http://localhost:8080
# Production (behind a reverse proxy): https://ai.your-domain.com
UXOPIAN_AI_PUBLIC_URL=http://localhost:8080/share/uxopian-ai

# --- Alfresco admin credentials ---
# Used by ARender to connect to the Alfresco CMIS endpoint.
# Defaults (admin/admin) work for this dev stack.
ALFRESCO_ADMIN_USER=admin
ALFRESCO_ADMIN_PASSWORD=admin

# --- Alfresco default tenant ID ---
ALFRESCO_DEFAULT_TENANT_ID=Tenant-development

# --- LLM API keys ---
# Set at least one provider key.
# Configure the active provider in: config/llm-clients-config.yml
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
