{
  "asOf": "2026.5.0",
  "profiles": [
    {
      "id": "view",
      "title": "View documents",
      "summary": "PDF, Office, emails, CAD, spreadsheets with an interactive view, video, audio and images. Navigation, search, thumbnails, table of contents, several documents side by side. On the roadmap: PDF layers, image adjustments."
    },
    {
      "id": "download",
      "title": "Download and print",
      "summary": "Download the original file or a PDF, print the current document or a whole set. In preview: download with annotations, one merged PDF for a set. On the roadmap: all originals as a ZIP, print with annotations."
    },
    {
      "id": "annotate",
      "title": "Annotate and review",
      "summary": "Highlight, underline, strikethrough, rectangles, circles, arrows, freehand, text, comments with replies and status. In development: stamps and shape styles. On the roadmap: user bookmarks. Not in Horizon: polygon and polyline."
    },
    {
      "id": "embed",
      "title": "Embed in your application",
      "summary": "Web Component, JavaScript API and events, TypeScript definitions, repository connectors, REST APIs."
    },
    {
      "id": "customize",
      "title": "Customize the viewer",
      "summary": "Your colors and styles with CSS, no ARender branding, interface in 15 languages. On the roadmap: toolbar configuration and default annotation styles. Not in Horizon: Classic plugins and custom toolbar buttons."
    },
    {
      "id": "rights",
      "title": "Control who can do what",
      "summary": "Permissions per user and per document from your repository: view, download, print, upload, annotate.",
      "newIn": "2026.5.0"
    },
    {
      "id": "advanced",
      "title": "Redact, compare, build documents",
      "summary": "Redaction is in preview, off by default. Watermarks are in development. Document builder and text comparison are on the roadmap."
    }
  ],
