# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4

# Markdown files
[*.md]
indent_size = 4
tab_width = 4

# TypeScript and JavaScript files
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 4
tab_width = 4

# JSON files
[*.json]
indent_size = 4
tab_width = 4

# YAML files
[*.{yml,yaml}]
indent_size = 4
tab_width = 4

# CSS and SCSS files
[*.{css,scss,sass}]
indent_size = 4
tab_width = 4
